<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.KulaPro" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      What the window shows before the first Compose frame.

      Without this the app opened on a blank white rectangle for as long as the process took
      to start, which reads as a hang rather than as a launch. The brand green and the mark
      make that same wait read as the app opening.
    -->
    <style name="Theme.KulaPro.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.KulaPro</item>
    </style>
</resources>
