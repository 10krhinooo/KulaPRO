<?xml version="1.0" encoding="utf-8"?>
<!--
  The KulaPro mark: a bowl with a sprig rising out of it.

  "Kula" is Swahili for "eat", so the mark is food rather than a letterform. Everything sits
  inside the 66dp adaptive icon safe zone, so no part of it is clipped whatever mask the
  launcher applies. Shapes are solid and chunky rather than fine, because the icon is read
  at 48dp far more often than at 108dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sprig: stem and two leaves, in the brand amber so the mark is not single colour. -->
    <path
        android:fillColor="#FFB868"
        android:pathData="M52.5,58 L52.5,34 a1.5,1.5 0 0 1 3,0 L55.5,58 z" />
    <path
        android:fillColor="#FFB868"
        android:pathData="M54,44 C45,44 39.5,38.5 39,30.5 C48,30 54,35.5 54,44 z" />
    <path
        android:fillColor="#FFDDB7"
        android:pathData="M54,50 C63,50 68.5,44.5 69,36.5 C60,36 54,41.5 54,50 z" />

    <!-- Bowl rim: a flat bar so the bowl reads as a bowl and not as a half circle. -->
    <path
        android:fillColor="#FCF9F5"
        android:pathData="M26,56 h56 a3.5,3.5 0 0 1 0,7 h-56 a3.5,3.5 0 0 1 0,-7 z" />

    <!-- Bowl body. -->
    <path
        android:fillColor="#FCF9F5"
        android:pathData="M30,63 h48 a24,24 0 0 1 -48,0 z" />
</vector>
